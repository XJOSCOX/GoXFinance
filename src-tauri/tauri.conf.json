{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoXPlan",
  "version": "0.2.0",
  "identifier": "com.goxplan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "GoXPlan", "width": 1440, "height": 900, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"] },
  "plugins": { "sql": { "preload": ["sqlite:goxplan.sqlite"] } }
}
