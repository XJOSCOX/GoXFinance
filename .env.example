API_PORT=3001
FRONTEND_ORIGIN=http://localhost:1420
DATA_DIR=./data
NODE_ENV=development
# Legacy plaintext mode preserves existing installations. Never switch automatically.
DATABASE_ENCRYPTION=plaintext
# After separately authorized encrypted cutover, point to the verified candidate.
# DATABASE_FILE=./data/goxfinance_encrypted.sqlite
# Optional automatic unlock, backend only. Leave blank for the hidden terminal prompt.
# WARNING: the real .env stores this in plaintext; anyone who reads it can unlock the DB.
# Keep .env private and out of Git/backups. Never use a VITE_ prefix for secrets.
# Use your EXISTING database passphrase, quoted if it contains spaces or #.
DATABASE_PASSPHRASE=
