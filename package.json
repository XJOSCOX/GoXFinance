{
  "name": "goxfinance",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite apps/web --config apps/web/vite.config.ts",
    "start:api": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write",
    "test": "vitest run --config vitest.config.ts",
    "build": "npm run typecheck && tsup apps/api/src/server.ts apps/api/src/modules/payroll/documents/worker.ts --tsconfig apps/api/tsconfig.json --format esm --platform node --out-dir apps/api/dist --external better-sqlite3 --external argon2 --external exceljs --external pdfkit --external plaid --external pdfjs-dist --external tesseract.js --external @napi-rs/canvas && vite build apps/web --config apps/web/vite.config.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:encryption": "tsx apps/api/src/db/encryption/cli.ts"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@napi-rs/canvas": "^1.0.12",
    "@tesseract.js-data/eng": "^1.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "plaid": "^49.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-plaid-link": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
